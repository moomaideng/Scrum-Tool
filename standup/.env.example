# Public origin only; the application path is always /standup.
STANDUP_APP_ORIGIN=http://localhost:4174

# Google Identity Services web client ID.
GOOGLE_CLIENT_ID=

# Google Sheets API service-account key JSON, encoded as one base64 line.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# For local Docker, a read-only key file may be used instead of the base64 value.
GOOGLE_SERVICE_ACCOUNT_HOST_FILE=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=

# Gmail SMTP defaults. Use a Google app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
